{
  "name": "Royal Wedding Heritage",
  "description": "Regal Rajputana & Palace wedding theme with gold accents, live countdown, and auspicious shlokas",
  "entry": "index.html",
  "version": "1.0.0",
  "customerFields": [
    {
      "key": "groomName",
      "label": "Groom Name",
      "type": "text",
      "required": true,
      "placeholder": "Aarav Sharma"
    },
    {
      "key": "brideName",
      "label": "Bride Name",
      "type": "text",
      "required": true,
      "placeholder": "Diya Patel"
    },
    {
      "key": "weddingDate",
      "label": "Wedding Date",
      "type": "date",
      "required": true
    },
    {
      "key": "venue",
      "label": "Wedding Venue",
      "type": "text",
      "required": true,
      "placeholder": "Grand Palace Hotel, Bypass Road"
    },
    {
      "key": "city",
      "label": "City",
      "type": "text",
      "required": true,
      "placeholder": "Indore"
    },
    {
      "key": "story",
      "label": "Couple Story",
      "type": "textarea",
      "required": false,
      "placeholder": "Two souls, one beautiful journey..."
    },
    {
      "key": "familyMessage",
      "label": "Family Welcome Message",
      "type": "textarea",
      "required": false,
      "placeholder": "We warmly invite you to shower your blessings on our auspicious day."
    },
    {
      "key": "couplePhoto",
      "label": "Couple Photo URL",
      "type": "image",
      "required": false
    }
  ],
  "designSettings": [
    {
      "key": "backgroundColor",
      "label": "Background Color",
      "type": "color",
      "default": "#3b0914"
    },
    {
      "key": "primaryColor",
      "label": "Gold Accent Color",
      "type": "color",
      "default": "#d4af37"
    },
    {
      "key": "textColor",
      "label": "Text Color",
      "type": "color",
      "default": "#fbf8f2"
    },
    {
      "key": "headingFont",
      "label": "Heading Font",
      "type": "font",
      "default": "Playfair Display"
    }
  ]
}
